amends "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.39.0/hk@1.39.0#/Builtins.pkl"

exclude = List("node_modules", "keeb_pcb/keebfromblank/fp-info-cache")

local formatters = new Mapping<String, Step> {
    ["ruff"] = (Builtins.ruff) {
        exclude = "*noqa*"
    }
    ["ruff_format"] = (Builtins.ruff_format) {
        output_summary = "hide"
        exclude = "*noqa*"
    }
    ["prettier"] = (Builtins.prettier) {
        batch = false
    }
    ["pkl"] = Builtins.pkl
    ["newlines"] = Builtins.newlines
    ["mixed_line_ending"] = Builtins.mixed_line_ending
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["shfmt"] = Builtins.shfmt
    ["just"] {
        workspace_indicator = "hk.pkl"
        fix = "just --fmt --unstable {{workspace}}"
    }
    ["mise"] {
        workspace_indicator = "hk.pkl"
        fix = "mise fmt"
    }
    ["clang"] {
        glob = List("*.ino")
        fix = "clang-format -i {{files}}"
    }
}

local linters = new Mapping<String, Step> {
    ["shellcheck"] = Builtins.shellcheck
    ["detect_private_key"] = Builtins.detect_private_key
    ["gitleaks"] {
        workspace_indicator = "hk.pkl"
        check = "gitleaks git {{workspace}} --no-banner --pre-commit --log-level=fatal"
    }
    ["trufflehog"] {
        glob = List("*")
        check = "trufflehog filesystem --fail --no-update --no-verification --log-level=-1 {{files}}"
        output_summary = "hide"
    }
//     ["detect-secrets"] {
//         glob = List("*")
//         check = "detect-secrets-hook -n {{files}}"
//         batch = true
//     }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = new Mapping<String, Step> {...formatters ...linters}
    }
    ["check"] {
      fix = false
      steps = new Mapping<String, Step> {...formatters ...linters}
    }
    ["fix"] {
        fix = true
        steps = formatters
    }
}
